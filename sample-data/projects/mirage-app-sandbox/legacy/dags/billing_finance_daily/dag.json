{
  "id": "billing_finance_daily",
  "name": "Billing & Finance Daily (Spark)",
  "description": "Invoice, payment, and finance mart builds",
  "schedule": "0 4 * * *",
  "owner": "etl.finance@demo.local",
  "tags": [
    "billing",
    "finance",
    "spark"
  ],
  "timezone": "UTC",
  "engine": "spark",
  "tasks": [
    {
      "id": "spark_invoice_fact",
      "name": "Spark \u00b7 Invoice facts",
      "script": "scripts/01_spark_invoice_fact.sh",
      "sql": [
        "sql/spark_invoice_fact.sql"
      ],
      "spark": "spark/spark_invoice_fact.py",
      "depends_on": [],
      "sla_minutes": 180,
      "params": {
        "engine": "spark",
        "sources": [
          "stg_invoice_hdr",
          "stg_invoice_line",
          "dim_account",
          "ref_charge_type",
          "ref_currency"
        ],
        "targets": [
          "fact_invoice",
          "fact_invoice_line"
        ]
      },
      "writes": [
        "fact_invoice",
        "fact_invoice_line"
      ]
    },
    {
      "id": "spark_payment_fact",
      "name": "Spark \u00b7 Payment facts",
      "script": "scripts/02_spark_payment_fact.sh",
      "sql": [
        "sql/spark_payment_fact.sql"
      ],
      "spark": "spark/spark_payment_fact.py",
      "depends_on": [
        "spark_invoice_fact"
      ],
      "sla_minutes": 180,
      "params": {
        "engine": "spark",
        "sources": [
          "stg_payment",
          "fact_invoice",
          "dim_account",
          "ref_pay_method",
          "ref_currency"
        ],
        "targets": [
          "fact_payment"
        ]
      },
      "writes": [
        "fact_payment"
      ]
    },
    {
      "id": "spark_finance_mart",
      "name": "Spark \u00b7 Finance 360 mart",
      "script": "scripts/03_spark_finance_mart.sh",
      "sql": [
        "sql/spark_finance_mart.sql"
      ],
      "spark": "spark/spark_finance_mart.py",
      "depends_on": [
        "spark_payment_fact"
      ],
      "sla_minutes": 180,
      "params": {
        "engine": "spark",
        "sources": [
          "fact_invoice",
          "fact_invoice_line",
          "fact_payment",
          "dim_account",
          "agg_usage_hourly"
        ],
        "targets": [
          "mart_finance_360",
          "mart_ar_aging"
        ]
      },
      "writes": [
        "mart_finance_360",
        "mart_ar_aging"
      ]
    }
  ]
}
